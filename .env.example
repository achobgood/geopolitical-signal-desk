SUPABASE_URL=https://uzqpndpuqubfygjwnhiv.supabase.co
# Set these directly in Render Environment. Never commit real values.
SUPABASE_SECRET_KEY=
SIGNAL_DESK_API_KEY=
# Alternative: store only the token's SHA-256 digest on the server.
# The caller still supplies the original SIGNAL_DESK_API_KEY as Bearer token.
SIGNAL_DESK_API_KEY_SHA256=
# Optional independent read-only Site/MCP credential digest; all writes denied.
SIGNAL_DESK_READ_KEY_SHA256=
# Optional Site owner writer: POST /v1/search-intake only. Never give it to browsers.
SIGNAL_DESK_SEARCH_WRITER_KEY_SHA256=
# Optional compatibility alias: SUPABASE_SERVICE_ROLE_KEY

# Optional OpenAI model reviewer. Store the key only in the server environment.
# Modes: disabled, preview, publish. Publish is limited to reviewed official facts.
SIGNAL_DESK_MODEL_REVIEW=disabled
OPENAI_API_KEY=

# Optional official SEC filing metadata collector. Use YOUR real monitored
# organizational contact identity, per SEC fair access; blank = not_configured.
SEC_USER_AGENT=
# Optional licensed read-only equity market feed. Keys server-side only.
# SIP requires entitled consolidated data plan. IEX is partial exchange ONLY.
ALPACA_MARKET_DATA_KEY_ID=
ALPACA_MARKET_DATA_SECRET=
# Preferred free mode: 15+ minute-delayed historical SIP stock/ETF bars.
# Also supported: iex_realtime (single exchange); entitled_sip_realtime (paid rights).
# Historical-only mode never calls latest quote or trading endpoints.
ALPACA_DATA_MODE=disabled
# Legacy mode; do not set together with ALPACA_DATA_MODE.
ALPACA_DATA_FEED=disabled
